{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rtb.local/schema/colmap.schema.json",
  "title": "T2 列名映射输出",
  "type": "object",
  "required": ["columns"],
  "additionalProperties": false,
  "properties": {
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["src", "std", "confidence", "evidence"],
        "additionalProperties": false,
        "properties": {
          "src": { "type": "string", "minLength": 1, "description": "原列名，原样拷贝" },
          "std": {
            "type": ["string", "null"],
            "description": "标准字段名；无把握或标准表无对应字段时为 null"
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    }
  }
}
