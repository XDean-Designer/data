    {
      "id": "hard_longtail",
      "origin": "构造样本 · 长尾写法（列名刻意**不进**同义词词典，专测规则层的天花板）",
      "target": "member",
      "sheet": "会员资料",
      "header": ["客人称呼", "联络号码", "卡面编号", "充值本金", "尚余金额", "卡到期", "入会渠道", "性别", "生日", "备注"],
